{
	"name": "speech-to-text-api",
	"version": "0.0.1",
	"description": "A speech-to-text api for the companion UI",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsc && pnpm copy:scripts",
		"format": "prettier --write .",
		"copy:scripts": "cp src/*.sh dist/",
		"preview": "pnpm build && node dist/index.js",
		"cleanup": "rm -rf podcast.mp3 podcast.mp4 podcast.srt podcast.jpg podcast_transcribed.mp4 segments",
		"test": "echo \"Error: no test specified\" && exit 1"
	},
	"keywords": [
		"Speech-To-Text",
		"Podcast",
		"Media",
		"Accessibility"
	],
	"author": "",
	"license": "ISC",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "^11.1.3",
			"onFail": "download"
		}
	},
	"type": "commonjs",
	"dependencies": {
		"audio2textjs": "^1.0.5",
		"express": "^5.3.0"
	},
	"devDependencies": {
		"@types/express": "^5.0.6",
		"@types/node": "^26.6.5",
		"prettier": "^3.9.10",
		"typescript": "^7.0.2"
	}
}
